# Optional: defaults work without this file. Copy to .env to override them.
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:3001
# Relative paths resolve from the repository root.
DATABASE_PATH=./data/blackout.sqlite
LOG_LEVEL=info
# Server only. Leave blank for telemetry-only use; never commit your key.
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_CHECKPOINT_MS=5000
JEV_TIMEOUT_MS=15000
JEV_MAX_ATTEMPTS=2
POLICY_INCIDENT_PROBABILITY=0.8
POLICY_CLASSIFICATION_CONFIDENCE=0.75
POLICY_INCIDENT_SEVERITY=2
# Optional target for npm run evaluate (the already-running backend).
BLACKOUT_API_URL=http://localhost:3001
# Optional Compose host ports; browser origin/address follow these values.
BLACKOUT_WEB_PORT=3000
BLACKOUT_API_PORT=3001
